<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Jellyfin 10.11 runs on .NET 9, Jellyfin 12.0 on .NET 10. One build each. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Version>1.5.0</Version>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.0" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Views\configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="static\icon.png">
      <Link>image.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>

